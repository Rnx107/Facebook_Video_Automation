# Copy this to .env and fill in your values
# Get these from the auth steps in README / chat
FB_PAGE_ID=your_facebook_page_id_here
FB_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token_here
FB_API_VERSION=v23.0

# For youtube_to_meta.py — free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
PODCAST_NAME=My Podcast

# For publish_folder.py — folder to watch + daily slots (local time, 2/day)
REELS_FOLDER=reels
POST_TIMES=10:00,19:00
